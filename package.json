{
  "name": "kit",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "tools"
    ],
    "catalog": {
      "@cloudflare/workers-types": "5.20261024.1",
      "@effect/ai-cloudflare": "4.0.6",
      "@effect/platform-browser": "4.0.6",
      "@effect/platform-bun": "4.0.6",
      "@effect/tsgo": "0.56.0",
      "@effect/vitest": "4.0.6",
      "effect": "4.0.6",
      "oxfmt": "0.74.0",
      "oxlint": "1.89.0",
      "oxlint-tsgolint": "7.0.2005",
      "typescript": "7.0.2",
      "vitest": "5.0.5"
    }
  },
  "type": "module",
  "scripts": {
    "postinstall": "effect-tsgo patch",
    "check": "bun run typecheck && bun run lint && oxfmt --check && bun tools/src/main.ts check",
    "check:swift": "bun tools/src/main.ts swift",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint",
    "test": "bun tools/src/main.ts test",
    "format": "oxfmt",
    "build": "bun tools/src/main.ts build build/"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
